{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI: Uvicron",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app", // Replace "main" with your Python file name and "app" with your FastAPI instance name
                "--reload",
                "--host",
                "0.0.0.0",
                "--port",
                "8000"
            ],
            "console": "integratedTerminal",
            "justMyCode": false // Set to false to debug into library code if needed
        }
    ]   
}